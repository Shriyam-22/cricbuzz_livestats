# Copy this file to .env and fill in your values. Never commit .env.

# Cricbuzz Cricket API (RapidAPI) - get the key from RapidAPI > Console > your app > Authorization
RAPIDAPI_KEY=your_key_here
RAPIDAPI_HOST=cricbuzz-cricket.p.rapidapi.com

# How long API answers are reused before calling again (saves your free quota)
API_CACHE_MINUTES=5

# Database: sqlite (default, nothing to install), mysql or postgresql
DB_ENGINE=sqlite
# SQLITE_PATH=data/cricbuzz.db

# Only for mysql / postgresql:
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=cricbuzz
# DB_USER=
# DB_PASSWORD=
